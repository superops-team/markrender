<!DOCTYPE html>
<html>
<head>
    <title>WebChannel错误处理测试</title>
    <script src="./webchannel-core.js"></script>
</head>
<body>
    <h1>WebChannel错误处理测试</h1>
    <div id="drawing-area">Excalidraw画板区域</div>
    
    <script>
        // 模拟Excalidraw初始化
        console.log("开始初始化Excalidraw...");
        
        // 即使WebChannel初始化失败，也不会影响画板展示
        window.WebChannelManager.init('excalidraw_test')
            .then(() => {
                console.log("WebChannel初始化完成");
            })
            .catch((error) => {
                console.log("WebChannel初始化失败，但不影响画板展示:", error);
            });
            
        // 模拟发送消息
        setTimeout(() => {
            window.WebChannelManager.sendToBackend('testAction', {data: 'test'})
                .then(response => {
                    console.log("消息发送成功:", response);
                })
                .catch(error => {
                    console.log("消息发送失败，但不影响画板展示:", error);
                });
        }, 1000);
        
        // 模拟画板渲染
        document.getElementById('drawing-area').innerHTML = `
            <div style="width: 800px; height: 600px; border: 1px solid #ccc; background: #f9f9f9;">
                <h2>Excalidraw画板模拟</h2>
                <p>即使WebChannel出现异常，画板仍能正常显示</p>
                <div style="width: 100px; height: 100px; background: #007acc; margin: 20px;"></div>
            </div>
        `;
    </script>
</body>
</html>