#!/usr/bin/env python3
"""
测试用例：直接QWebChannel通信 - Excalidraw白板
测试excalidraw前端在重写后的功能
"""

import sys
import os
import json
import time
from PySide6.QtWidgets import QApplication
from PySide6.QtWebEngineWidgets import QWebEngineView
from PySide6.QtWebChannel import QWebChannel
from PySide6.QtCore import QUrl, QObject, Slot, Signal, QTimer

# 添加项目根目录到路径
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

class TestBackendInterface(QObject):
    def __init__(self):
        super().__init__()
        self.received_messages = []
        self.board_id = None
        self.current_data = '[]'
        
    @Slot(str)
    def handle_web_response(self, response_json):
        """处理前端响应"""
        try:
            response = json.loads(response_json)
            self.received_messages.append(response)
            print(f"收到前端响应: {response}")
            
            # 模拟保存数据
            if response.get('action') == 'saveExcalidrawData':
                self.current_data = response.get('data', {}).get('content', '[]')
                print(f"保存数据: {len(self.current_data)} 字符")
        except Exception as e:
            print(f"解析响应失败: {e}")
    
    @Slot()
    def frontend_ready(self):
        """前端就绪回调"""
        print("前端已就绪")

class ExcalidrawWebChannelTest:
    def __init__(self):
        self.app = QApplication(sys.argv)
        self.view = QWebEngineView()
        self.backend = TestBackendInterface()
        self.channel = QWebChannel()
        
    def setup_webchannel(self):
        """设置WebChannel"""
        self.channel.registerObject("backendInterface", self.backend)
        self.view.page().setWebChannel(self.channel)
        
    def load_excalidraw_page(self):
        """加载excalidraw页面"""
        # 使用构建后的页面
        page_path = os.path.join(
            os.path.dirname(__file__), 
            '..', 'app', 'editor', 'plugins', 'excalidraw', 'index.html'
        )
        
        if os.path.exists(page_path):
            self.view.load(QUrl.fromLocalFile(page_path))
            print(f"加载页面: {page_path}")
        else:
            print(f"页面不存在: {page_path}")
            return False
        return True
    
    def test_set_board_id(self):
        """测试设置画板ID"""
        print("\n=== 测试设置画板ID ===")
        
        def send_test_message():
            test_board_id = "test-board-123"
            js_code = f"""
                if (window.excalidrawChannel) {{
                    window.excalidrawChannel.setBoardId('{test_board_id}');
                    console.log('设置画板ID:', '{test_board_id}');
                }}
            """
            self.view.page().runJavaScript(js_code)
            self.backend.board_id = test_board_id
            print(f"设置画板ID: {test_board_id}")
        
        QTimer.singleShot(2000, send_test_message)
    
    def test_load_data(self):
        """测试加载数据"""
        print("\n=== 测试加载数据 ===")
        
        def send_load_data():
            test_data = '[{"id":"test1","type":"rectangle","x":100,"y":100,"width":100,"height":100}]'
            js_code = f"""
                if (window.excalidrawChannel) {{
                    window.excalidrawChannel.loadExcalidrawData('{test_data}');
                    console.log('加载测试数据');
                }}
            """
            self.view.page().runJavaScript(js_code)
            print("加载测试数据")
        
        QTimer.singleShot(3000, send_load_data)
    
    def test_get_data(self):
        """测试获取数据"""
        print("\n=== 测试获取数据 ===")
        
        def send_get_data():
            js_code = """
                if (window.excalidrawChannel) {
                    const data = window.excalidrawChannel.getExcalidrawData();
                    console.log('获取数据:', data);
                    return data;
                }
            """
            self.view.page().runJavaScript(js_code, lambda result: print(f"获取的数据: {result}"))
            print("请求获取数据")
        
        QTimer.singleShot(4000, send_get_data)
    
    def test_save_data(self):
        """测试保存数据"""
        print("\n=== 测试保存数据 ===")
        
        def send_save_data():
            test_save_data = '[{"id":"save-test","type":"circle","x":200,"y":200,"width":50,"height":50}]'
            js_code = f"""
                if (window.excalidrawChannel) {{
                    window.excalidrawChannel.saveData('{test_save_data}');
                    console.log('保存测试数据');
                }}
            """
            self.view.page().runJavaScript(js_code)
            print("保存测试数据")
        
        QTimer.singleShot(5000, send_save_data)
    
    def run_tests(self):
        """运行所有测试"""
        print("开始测试直接QWebChannel通信 - Excalidraw白板")
        
        self.setup_webchannel()
        
        if not self.load_excalidraw_page():
            return False
        
        self.view.show()
        self.view.setWindowTitle("Excalidraw WebChannel测试")
        self.view.resize(1000, 700)
        
        # 设置测试序列
        self.test_set_board_id()
        self.test_load_data()
        self.test_get_data()
        self.test_save_data()
        
        # 7秒后关闭
        QTimer.singleShot(7000, self.app.quit)
        
        return self.app.exec()

def main():
    """主函数"""
    print("=" * 50)
    print("直接QWebChannel通信测试 - Excalidraw白板")
    print("=" * 50)
    
    test = ExcalidrawWebChannelTest()
    success = test.run_tests()
    
    print(f"\n测试完成: {'成功' if success else '失败'}")
    return success

if __name__ == "__main__":
    success = main()
    sys.exit(0 if success else 1)